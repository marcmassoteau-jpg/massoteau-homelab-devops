// Python Application Pipeline
// Demonstrates Jenkins pipeline for Python/Flask application

@Library('cicd-shared-library') _

pipeline {
    agent {
        kubernetes {
            yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: python
    image: python:3.11-alpine
    command: ['cat']
    tty: true
  - name: kaniko
    image: gcr.io/kaniko-project/executor:debug
    command: ['sleep']
    args: ['infinity']
    volumeMounts:
    - name: kaniko-secret
      mountPath: /kaniko/.docker
  - name: kubectl
    image: bitnami/kubectl:latest
    command: ['cat']
    tty: true
  - name: trivy
    image: aquasec/trivy:latest
    command: ['cat']
    tty: true
  volumes:
  - name: kaniko-secret
    secret:
      secretName: registry-credentials
      items:
      - key: .dockerconfigjson
        path: config.json
"""
        }
    }

    environment {
        PYTHON_VERSION = '3.11'
        APP_NAME = 'python-demo-app'
        CI_REGISTRY = 'registry.gitlab.homelab.local'
        REGISTRY_IMAGE = "${env.CI_REGISTRY}/${env.APP_NAME}"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 45, unit: 'MINUTES')
        timestamps()
    }

    stages {
        stage('Build') {
            steps {
                script {
                    buildApp(
                        type: 'python',
                        buildCommand: 'pip install --cache-dir .pip-cache -r requirements.txt && python -m build',
                        outputDir: 'dist'
                    )
                }
            }
        }

        stage('Test') {
            parallel {
                stage('Unit Tests') {
                    steps {
                        container('python') {
                            script {
                                sh '''
                                    pip install --cache-dir .pip-cache -r requirements.txt -r requirements-dev.txt
                                    pytest tests/unit --cov --cov-report=xml --cov-report=term --junitxml=test-results.xml
                                '''

                                // Publish results
                                junit 'test-results.xml'

                                // Publish coverage
                                publishHTML(target: [
                                    allowMissing: false,
                                    alwaysLinkToLastBuild: true,
                                    keepAll: true,
                                    reportDir: 'htmlcov',
                                    reportFiles: 'index.html',
                                    reportName: 'Coverage Report'
                                ])
                            }
                        }
                    }
                }

                stage('Integration Tests') {
                    when {
                        anyOf {
                            branch 'main'
                            branch 'develop'
                        }
                    }
                    agent {
                        kubernetes {
                            yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: python
    image: python:3.11-alpine
    command: ['cat']
    tty: true
  - name: postgres
    image: postgres:15-alpine
    env:
    - name: POSTGRES_DB
      value: testdb
    - name: POSTGRES_USER
      value: testuser
    - name: POSTGRES_PASSWORD
      value: testpass
"""
                        }
                    }
                    steps {
                        container('python') {
                            script {
                                sh 'sleep 5'  // Wait for postgres

                                withEnv(['DATABASE_URL=postgresql://testuser:testpass@localhost:5432/testdb']) {
                                    sh '''
                                        pip install --cache-dir .pip-cache -r requirements.txt -r requirements-dev.txt
                                        pytest tests/integration -v
                                    '''
                                }
                            }
                        }
                    }
                }

                stage('Lint') {
                    steps {
                        container('python') {
                            script {
                                sh '''
                                    pip install flake8 black mypy
                                    echo "Running flake8..."
                                    flake8 . --count --select=E9,F63,F7,F82 --show-source --statistics || true
                                    echo "Running black..."
                                    black --check . || true
                                    echo "Running mypy..."
                                    mypy . || true
                                '''
                            }
                        }
                    }
                }
            }
        }

        stage('Security') {
            parallel {
                stage('Dependencies') {
                    steps {
                        container('python') {
                            script {
                                sh '''
                                    pip install safety
                                    pip install --cache-dir .pip-cache -r requirements.txt
                                    safety check --json > safety-report.json || true
                                    safety check || true
                                '''
                                archiveArtifacts(
                                    artifacts: 'safety-report.json',
                                    allowEmptyArchive: true,
                                    fingerprint: true
                                )
                            }
                        }
                    }
                }

                stage('Secrets') {
                    steps {
                        script {
                            securityScan(
                                type: 'secrets',
                                allowFailure: false
                            )
                        }
                    }
                }
            }
        }

        stage('Package') {
            when {
                anyOf {
                    branch 'main'
                    branch 'develop'
                }
            }
            steps {
                script {
                    unstash 'build-artifacts'

                    withCredentials([
                        usernamePassword(
                            credentialsId: 'registry-credentials',
                            usernameVariable: 'REGISTRY_USER',
                            passwordVariable: 'REGISTRY_PASSWORD'
                        )
                    ]) {
                        dockerBuild(
                            dockerfile: 'Dockerfile',
                            imageName: env.REGISTRY_IMAGE,
                            imageTag: env.GIT_COMMIT
                        )
                    }
                }
            }
        }

        stage('Scan Container') {
            when {
                anyOf {
                    branch 'main'
                    branch 'develop'
                }
            }
            steps {
                script {
                    securityScan(
                        type: 'trivy-image',
                        image: "${env.REGISTRY_IMAGE}:${env.GIT_COMMIT}",
                        severity: 'HIGH,CRITICAL',
                        allowFailure: true
                    )
                }
            }
        }

        stage('Deploy') {
            stages {
                stage('Deploy Dev') {
                    when {
                        branch 'develop'
                    }
                    steps {
                        script {
                            k8sDeploy(
                                namespace: 'development',
                                deployment: env.APP_NAME,
                                image: "${env.REGISTRY_IMAGE}:${env.GIT_COMMIT}",
                                replicas: 1
                            )
                        }
                    }
                }

                stage('Deploy Review') {
                    when {
                        changeRequest()
                    }
                    steps {
                        script {
                            k8sDeploy.deployReview(
                                deployment: env.APP_NAME,
                                image: "${env.REGISTRY_IMAGE}:${env.GIT_COMMIT}"
                            )
                        }
                    }
                }

                stage('Deploy Staging') {
                    when {
                        branch 'main'
                    }
                    steps {
                        script {
                            k8sDeploy(
                                namespace: 'staging',
                                deployment: env.APP_NAME,
                                image: "${env.REGISTRY_IMAGE}:${env.GIT_COMMIT}",
                                replicas: 2
                            )
                        }
                    }
                }

                stage('Deploy Production') {
                    when {
                        anyOf {
                            branch 'main'
                            tag pattern: 'v\\d+\\.\\d+\\.\\d+', comparator: 'REGEXP'
                        }
                    }
                    steps {
                        script {
                            input message: 'Deploy to Production?', ok: 'Deploy'

                            k8sDeploy(
                                namespace: 'production',
                                deployment: env.APP_NAME,
                                image: "${env.REGISTRY_IMAGE}:${env.GIT_COMMIT}",
                                replicas: 3
                            )
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo 'Python pipeline completed successfully!'
        }
        failure {
            echo 'Python pipeline failed!'
        }
    }
}
