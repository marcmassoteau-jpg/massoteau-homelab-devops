---
# Prometheus Traefik IngressRoute
# Generated by Ansible - do not edit manually
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: prometheus
  namespace: {{ monitoring_namespace }}
  labels:
    app.kubernetes.io/name: prometheus
    app.kubernetes.io/component: metrics
    app.kubernetes.io/part-of: monitoring
    managed-by: ansible
  annotations:
    description: "Prometheus web UI ingress via Traefik"
spec:
  entryPoints:
    - web
{% if monitoring_tls_enabled %}
    - websecure
{% endif %}
  routes:
    - match: Host(`{{ monitoring_prometheus_domain }}`)
      kind: Rule
      services:
        - name: kube-prometheus-stack-prometheus
          port: 9090
{% if monitoring_tls_enabled %}
  tls:
    certResolver: default
{% endif %}
