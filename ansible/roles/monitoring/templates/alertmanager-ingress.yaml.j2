---
# AlertManager Traefik IngressRoute
# Generated by Ansible - do not edit manually
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: alertmanager
  namespace: {{ monitoring_namespace }}
  labels:
    app.kubernetes.io/name: alertmanager
    app.kubernetes.io/component: alerting
    app.kubernetes.io/part-of: monitoring
    managed-by: ansible
  annotations:
    description: "AlertManager web UI ingress via Traefik"
spec:
  entryPoints:
    - web
{% if monitoring_tls_enabled %}
    - websecure
{% endif %}
  routes:
    - match: Host(`{{ monitoring_alertmanager_domain }}`)
      kind: Rule
      services:
        - name: kube-prometheus-stack-alertmanager
          port: 9093
{% if monitoring_tls_enabled %}
  tls:
    certResolver: default
{% endif %}
