---
# Velero Backup Schedule
# Generated by Ansible - do not edit manually
apiVersion: velero.io/v1
kind: Schedule
metadata:
  name: {{ item.name }}
  namespace: {{ velero_namespace }}
  labels:
    app.kubernetes.io/name: velero
    app.kubernetes.io/component: backup-schedule
    app.kubernetes.io/part-of: velero
    managed-by: ansible
  annotations:
    description: "Velero backup schedule managed by Ansible"
spec:
  schedule: "{{ item.schedule }}"
  template:
    ttl: {{ item.ttl | default(((velero_retention_days | int) * 24) | string + 'h0m0s') }}
{% if item.include_namespaces | default([]) | length > 0 %}
    includedNamespaces:
{% for ns in item.include_namespaces %}
      - {{ ns }}
{% endfor %}
{% endif %}
    storageLocation: default
    volumeSnapshotLocations: []
    defaultVolumesToFsBackup: {{ velero_default_volumes_to_fs_backup | lower }}
