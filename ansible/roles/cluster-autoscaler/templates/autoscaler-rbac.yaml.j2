---
# Cluster Autoscaler RBAC Resources
# Generated by Ansible - do not edit manually
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ cluster_autoscaler_service_account }}
  namespace: {{ cluster_autoscaler_namespace }}
  labels:
    app.kubernetes.io/name: cluster-autoscaler
    app.kubernetes.io/component: autoscaling
    app.kubernetes.io/part-of: devops-platform
    managed-by: ansible
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: cluster-autoscaler-role
  labels:
    app.kubernetes.io/name: cluster-autoscaler
    app.kubernetes.io/component: autoscaling
    managed-by: ansible
rules:
  # Read pods to detect pending pods (scale-up trigger)
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["get", "list", "watch"]
  # Read and manage nodes (cordon, drain for scale-down)
  - apiGroups: [""]
    resources: ["nodes"]
    verbs: ["get", "list", "watch", "patch", "update"]
  # Read node metrics for utilization checks
  - apiGroups: ["metrics.k8s.io"]
    resources: ["nodes", "pods"]
    verbs: ["get", "list"]
  # Evict pods during node drain
  - apiGroups: [""]
    resources: ["pods/eviction"]
    verbs: ["create"]
  # Read replicasets to check pod ownership
  - apiGroups: ["apps"]
    resources: ["replicasets", "deployments", "statefulsets", "daemonsets"]
    verbs: ["get", "list"]
  # Read events for logging
  - apiGroups: [""]
    resources: ["events"]
    verbs: ["create", "patch"]
  # Read configmaps for autoscaler configuration
  - apiGroups: [""]
    resources: ["configmaps"]
    verbs: ["get", "list", "watch"]
  # Manage jobs for scale operations
  - apiGroups: ["batch"]
    resources: ["jobs", "cronjobs"]
    verbs: ["get", "list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: cluster-autoscaler-binding
  labels:
    app.kubernetes.io/name: cluster-autoscaler
    app.kubernetes.io/component: autoscaling
    managed-by: ansible
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: cluster-autoscaler-role
subjects:
  - kind: ServiceAccount
    name: {{ cluster_autoscaler_service_account }}
    namespace: {{ cluster_autoscaler_namespace }}
