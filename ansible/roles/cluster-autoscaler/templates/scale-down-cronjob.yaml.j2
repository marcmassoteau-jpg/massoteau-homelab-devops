---
# Cluster Autoscaler - Scale-Down CronJob
# Checks node utilization and cordons/drains underutilized autoscale nodes
# Generated by Ansible - do not edit manually
apiVersion: batch/v1
kind: CronJob
metadata:
  name: cluster-autoscaler-scale-down
  namespace: {{ cluster_autoscaler_namespace }}
  labels:
    app.kubernetes.io/name: cluster-autoscaler
    app.kubernetes.io/component: scale-down
    app.kubernetes.io/part-of: devops-platform
    managed-by: ansible
spec:
  schedule: "{{ cluster_autoscaler_scale_down_interval }}"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      backoffLimit: 1
      activeDeadlineSeconds: 300
      template:
        metadata:
          labels:
            app.kubernetes.io/name: cluster-autoscaler
            app.kubernetes.io/component: scale-down
        spec:
          serviceAccountName: {{ cluster_autoscaler_service_account }}
          restartPolicy: Never
          containers:
            - name: scale-down-checker
              image: {{ cluster_autoscaler_image }}
              command:
                - /bin/sh
                - -c
                - |
                  set -e
                  echo "=== Cluster Autoscaler Scale-Down Check ==="
                  echo "Time: $(date -u '+%Y-%m-%d %H:%M:%S UTC')"

                  # Load configuration
                  MIN_NODES="${MIN_NODES}"
                  SCALE_DOWN_THRESHOLD="${SCALE_DOWN_THRESHOLD}"
                  SCALE_DOWN_DELAY="${SCALE_DOWN_DELAY}"
                  NODE_NAME_PREFIX="${NODE_NAME_PREFIX}"

                  # Count current nodes
                  CURRENT_NODES=$(kubectl get nodes --no-headers | wc -l)
                  echo "Current nodes: ${CURRENT_NODES}, Minimum: ${MIN_NODES}"

                  # Only consider scale-down if we have more than minimum nodes
                  if [ "${CURRENT_NODES}" -le "${MIN_NODES}" ]; then
                    echo "At minimum node count (${MIN_NODES}). No scale-down possible."
                    exit 0
                  fi

                  # Find autoscaled nodes (nodes matching the autoscale prefix)
                  AUTOSCALE_NODES=$(kubectl get nodes --no-headers -o custom-columns=NAME:.metadata.name | grep "^${NODE_NAME_PREFIX}" || true)

                  if [ -z "${AUTOSCALE_NODES}" ]; then
                    echo "No autoscaled nodes found. Nothing to scale down."
                    exit 0
                  fi

                  echo "Autoscaled nodes found:"
                  echo "${AUTOSCALE_NODES}"

                  # Check utilization of each autoscaled node
                  for NODE in ${AUTOSCALE_NODES}; do
                    echo ""
                    echo "Checking node: ${NODE}"

                    # Skip if node is already cordoned
                    IS_CORDONED=$(kubectl get node "${NODE}" -o json | jq -r '.spec.unschedulable // false')
                    if [ "${IS_CORDONED}" = "true" ]; then
                      echo "  Node is already cordoned. Checking if drain is safe..."

                      # Check if node has non-daemonset pods
                      POD_COUNT=$(kubectl get pods --all-namespaces --field-selector=spec.nodeName="${NODE}" -o json | \
                        jq '[.items[] | select(.metadata.ownerReferences[]?.kind != "DaemonSet")] | length')

                      if [ "${POD_COUNT}" -eq 0 ]; then
                        echo "  Node ${NODE} is drained. Ready for removal."
                        echo "  Run: scripts/autoscaling/proxmox-node-provisioner.sh --remove --name ${NODE}"

                        kubectl create event \
                          --for=cronjob/cluster-autoscaler-scale-down \
                          --namespace={{ cluster_autoscaler_namespace }} \
                          --type=Normal \
                          --reason="ScaleDown" \
                          --field-manager="cluster-autoscaler" \
                          "Node ${NODE} is drained and ready for removal" || true
                      else
                        echo "  Node still has ${POD_COUNT} non-daemonset pods. Waiting for drain."
                      fi
                      continue
                    fi

                    # Get node CPU utilization
                    NODE_CPU=$(kubectl top node "${NODE}" --no-headers 2>/dev/null | awk '{gsub(/%/,"",$3); print $3}' || echo "0")
                    echo "  CPU utilization: ${NODE_CPU}%"

                    if [ "${NODE_CPU}" -le "${SCALE_DOWN_THRESHOLD}" ]; then
                      echo "  Node is underutilized (${NODE_CPU}% <= ${SCALE_DOWN_THRESHOLD}%)"

                      # Check annotation for scale-down timestamp
                      SCALE_DOWN_TIME=$(kubectl get node "${NODE}" -o json | \
                        jq -r '.metadata.annotations["cluster-autoscaler/scale-down-candidate"] // ""')

                      CURRENT_TIME=$(date +%s)

                      if [ -z "${SCALE_DOWN_TIME}" ]; then
                        # Mark node as scale-down candidate
                        echo "  Marking as scale-down candidate (delay: ${SCALE_DOWN_DELAY}s)"
                        kubectl annotate node "${NODE}" \
                          "cluster-autoscaler/scale-down-candidate=${CURRENT_TIME}" \
                          --overwrite
                      else
                        # Check if delay has passed
                        ELAPSED=$((CURRENT_TIME - SCALE_DOWN_TIME))
                        echo "  Scale-down candidate for ${ELAPSED}s (threshold: ${SCALE_DOWN_DELAY}s)"

                        if [ "${ELAPSED}" -ge "${SCALE_DOWN_DELAY}" ]; then
                          echo "  SCALE-DOWN: Cordoning and draining node ${NODE}"

                          # Cordon the node
                          kubectl cordon "${NODE}"

                          # Drain the node (ignore daemonsets, force, delete local data)
                          kubectl drain "${NODE}" \
                            --ignore-daemonsets \
                            --delete-emptydir-data \
                            --force \
                            --timeout=120s || true

                          kubectl create event \
                            --for=cronjob/cluster-autoscaler-scale-down \
                            --namespace={{ cluster_autoscaler_namespace }} \
                            --type=Normal \
                            --reason="ScaleDown" \
                            --field-manager="cluster-autoscaler" \
                            "Cordoned and draining node ${NODE} (CPU: ${NODE_CPU}%)" || true
                        fi
                      fi
                    else
                      # Remove scale-down candidate annotation if utilization recovered
                      kubectl annotate node "${NODE}" \
                        "cluster-autoscaler/scale-down-candidate-" \
                        --overwrite 2>/dev/null || true
                      echo "  Node is adequately utilized. No action needed."
                    fi
                  done

                  echo ""
                  echo "=== Scale-Down Check Complete ==="
              envFrom:
                - configMapRef:
                    name: cluster-autoscaler-config
              resources:
                requests:
                  cpu: 50m
                  memory: 64Mi
                limits:
                  cpu: 200m
                  memory: 128Mi
