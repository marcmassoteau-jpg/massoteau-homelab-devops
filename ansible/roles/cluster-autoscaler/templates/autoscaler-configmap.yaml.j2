---
# Cluster Autoscaler Configuration
# Generated by Ansible - do not edit manually
apiVersion: v1
kind: ConfigMap
metadata:
  name: cluster-autoscaler-config
  namespace: {{ cluster_autoscaler_namespace }}
  labels:
    app.kubernetes.io/name: cluster-autoscaler
    app.kubernetes.io/component: configuration
    app.kubernetes.io/part-of: devops-platform
    managed-by: ansible
data:
  # Proxmox API configuration
  PROXMOX_API_URL: "{{ cluster_autoscaler_proxmox_api_url }}"
  PROXMOX_NODE: "{{ cluster_autoscaler_proxmox_node }}"
  VM_TEMPLATE_ID: "{{ cluster_autoscaler_vm_template_id }}"

  # Node resource specifications
  NODE_CPUS: "{{ cluster_autoscaler_node_cpus }}"
  NODE_MEMORY: "{{ cluster_autoscaler_node_memory }}"
  NODE_DISK: "{{ cluster_autoscaler_node_disk }}"

  # IP range for autoscaled nodes
  IP_RANGE_START: "{{ cluster_autoscaler_ip_range_start }}"
  IP_RANGE_END: "{{ cluster_autoscaler_ip_range_end }}"
  GATEWAY: "{{ cluster_autoscaler_gateway }}"
  NAMESERVER: "{{ cluster_autoscaler_nameserver }}"

  # Scaling thresholds
  MIN_NODES: "{{ cluster_autoscaler_min_nodes }}"
  MAX_NODES: "{{ cluster_autoscaler_max_nodes }}"
  SCALE_UP_THRESHOLD: "{{ cluster_autoscaler_scale_up_threshold }}"
  SCALE_DOWN_THRESHOLD: "{{ cluster_autoscaler_scale_down_threshold }}"
  SCALE_DOWN_DELAY: "{{ cluster_autoscaler_scale_down_delay }}"

  # Node name prefix for autoscaled nodes
  NODE_NAME_PREFIX: "k8s-autoscale"
