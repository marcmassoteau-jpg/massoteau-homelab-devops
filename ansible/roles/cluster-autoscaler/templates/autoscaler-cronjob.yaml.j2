---
# Cluster Autoscaler - Scale-Up CronJob
# Checks for pending pods and triggers Proxmox VM provisioning
# Generated by Ansible - do not edit manually
apiVersion: batch/v1
kind: CronJob
metadata:
  name: cluster-autoscaler-check
  namespace: {{ cluster_autoscaler_namespace }}
  labels:
    app.kubernetes.io/name: cluster-autoscaler
    app.kubernetes.io/component: scale-up
    app.kubernetes.io/part-of: devops-platform
    managed-by: ansible
spec:
  schedule: "{{ cluster_autoscaler_check_interval }}"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      backoffLimit: 1
      activeDeadlineSeconds: 120
      template:
        metadata:
          labels:
            app.kubernetes.io/name: cluster-autoscaler
            app.kubernetes.io/component: scale-up
        spec:
          serviceAccountName: {{ cluster_autoscaler_service_account }}
          restartPolicy: Never
          containers:
            - name: autoscaler
              image: {{ cluster_autoscaler_image }}
              command:
                - /bin/sh
                - -c
                - |
                  set -e
                  echo "=== Cluster Autoscaler Scale-Up Check ==="
                  echo "Time: $(date -u '+%Y-%m-%d %H:%M:%S UTC')"

                  # Load configuration from ConfigMap (mounted as env vars)
                  MAX_NODES="${MAX_NODES}"
                  SCALE_UP_THRESHOLD="${SCALE_UP_THRESHOLD}"

                  # Count current nodes
                  CURRENT_NODES=$(kubectl get nodes --no-headers | wc -l)
                  echo "Current nodes: ${CURRENT_NODES}/${MAX_NODES}"

                  # Check if we are at max capacity
                  if [ "${CURRENT_NODES}" -ge "${MAX_NODES}" ]; then
                    echo "Already at maximum node count (${MAX_NODES}). No scale-up needed."
                    exit 0
                  fi

                  # Check for pending pods (unschedulable due to insufficient resources)
                  PENDING_PODS=$(kubectl get pods --all-namespaces --field-selector=status.phase=Pending -o json | \
                    jq '[.items[] | select(.status.conditions[]? | select(.type=="PodScheduled" and .status=="False" and .reason=="Unschedulable"))] | length')

                  echo "Pending unschedulable pods: ${PENDING_PODS}"

                  if [ "${PENDING_PODS}" -gt 0 ]; then
                    echo "SCALE-UP TRIGGERED: ${PENDING_PODS} pods are pending due to insufficient resources"

                    # Calculate next available IP from the autoscale range
                    IP_START="${IP_RANGE_START}"
                    IP_PREFIX=$(echo "${IP_START}" | cut -d. -f1-3)
                    IP_LAST_OCTET_START=$(echo "${IP_START}" | cut -d. -f4)
                    IP_LAST_OCTET_END=$(echo "${IP_RANGE_END}" | cut -d. -f4)

                    # Find the next available IP by checking existing autoscale nodes
                    NEXT_IP=""
                    NODE_INDEX=0
                    for OCTET in $(seq ${IP_LAST_OCTET_START} ${IP_LAST_OCTET_END}); do
                      CANDIDATE_IP="${IP_PREFIX}.${OCTET}"
                      # Check if any node already has this IP
                      EXISTING=$(kubectl get nodes -o json | jq -r ".items[].status.addresses[] | select(.type==\"InternalIP\") | .address" | grep -c "^${CANDIDATE_IP}$" || true)
                      if [ "${EXISTING}" -eq 0 ]; then
                        NEXT_IP="${CANDIDATE_IP}"
                        NODE_INDEX=${OCTET}
                        break
                      fi
                    done

                    if [ -z "${NEXT_IP}" ]; then
                      echo "ERROR: No available IPs in autoscale range. Cannot provision new node."
                      exit 1
                    fi

                    NODE_NAME="${NODE_NAME_PREFIX}-$(printf '%02d' $((NODE_INDEX - IP_LAST_OCTET_START + 1)))"
                    echo "Provisioning new node: ${NODE_NAME} (${NEXT_IP})"
                    echo "  Template ID: ${VM_TEMPLATE_ID}"
                    echo "  CPUs: ${NODE_CPUS}, Memory: ${NODE_MEMORY}MB"

                    # Create an event to log the scale-up action
                    kubectl create event \
                      --for=cronjob/cluster-autoscaler-check \
                      --namespace={{ cluster_autoscaler_namespace }} \
                      --type=Normal \
                      --reason="ScaleUp" \
                      --field-manager="cluster-autoscaler" \
                      "Triggering scale-up: provisioning ${NODE_NAME} (${NEXT_IP}) for ${PENDING_PODS} pending pods" || true

                    echo "NOTE: VM provisioning requires external script execution."
                    echo "Run: scripts/autoscaling/proxmox-node-provisioner.sh --name ${NODE_NAME} --ip ${NEXT_IP}"
                  else
                    # Also check overall CPU utilization
                    AVG_CPU=$(kubectl top nodes --no-headers | awk '{gsub(/%/,"",$3); sum+=$3; count++} END {if(count>0) print int(sum/count); else print 0}')
                    echo "Average cluster CPU utilization: ${AVG_CPU}%"

                    if [ "${AVG_CPU}" -ge "${SCALE_UP_THRESHOLD}" ]; then
                      echo "WARNING: Cluster CPU utilization (${AVG_CPU}%) exceeds threshold (${SCALE_UP_THRESHOLD}%)"
                      echo "Consider scaling up proactively."
                    else
                      echo "Cluster is healthy. No scale-up needed."
                    fi
                  fi

                  echo "=== Scale-Up Check Complete ==="
              envFrom:
                - configMapRef:
                    name: cluster-autoscaler-config
              resources:
                requests:
                  cpu: 50m
                  memory: 64Mi
                limits:
                  cpu: 200m
                  memory: 128Mi
