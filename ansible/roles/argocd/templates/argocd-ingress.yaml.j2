---
# ArgoCD Traefik IngressRoute
# Generated by Ansible - do not edit manually
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: argocd-server
  namespace: {{ argocd_namespace }}
  labels:
    app.kubernetes.io/name: argocd
    app.kubernetes.io/component: server
    app.kubernetes.io/part-of: argocd
    managed-by: ansible
  annotations:
    description: "ArgoCD web UI ingress via Traefik"
spec:
  entryPoints:
    - web
{% if argocd_tls_enabled %}
    - websecure
{% endif %}
  routes:
    - match: Host(`{{ argocd_domain }}`)
      kind: Rule
      services:
        - name: argocd-server
          port: 80
{% if argocd_tls_enabled %}
  tls:
    certResolver: default
{% endif %}
