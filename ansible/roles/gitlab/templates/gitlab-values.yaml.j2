# GitLab Helm Chart Values - Generated by Ansible
# Role: gitlab
# Date: {{ ansible_date_time.iso8601 }}

#=============================================================================
# GLOBAL CONFIGURATION
#=============================================================================
global:
  edition: {{ gitlab_edition }}

  hosts:
    domain: {{ gitlab_domain.split('.')[1:] | join('.') }}
    https: {{ gitlab_tls_enabled | lower }}
    gitlab:
      name: {{ gitlab_domain }}
    registry:
      name: {{ gitlab_registry_domain }}
    minio:
      name: {{ gitlab_minio_domain }}

  ingress:
    enabled: true
    class: {{ gitlab_ingress_class }}
    configureCertmanager: {{ gitlab_certmanager_enabled | lower }}
    tls:
      enabled: {{ gitlab_tls_enabled | lower }}
    annotations:
      kubernetes.io/ingress.class: "{{ gitlab_ingress_class }}"

  initialRootPassword:
    secret: gitlab-initial-root-password
    key: password

  shell:
    port: 22

  time_zone: UTC

  psql:
    host: gitlab-postgresql
    port: 5432
    database: gitlabhq_production
    username: gitlab
    password:
      useSecret: true
      secret: gitlab-postgresql-password
      key: postgresql-postgres-password

  redis:
    host: gitlab-redis-master
    password:
      enabled: true
      secret: gitlab-redis-secret
      key: redis-password

  gitaly:
    enabled: true
    authToken:
      secret: gitlab-gitaly-secret
      key: token

  minio:
    enabled: {{ gitlab_minio_enabled | lower }}
    credentials:
      secret: gitlab-minio-secret

  registry:
    enabled: {{ gitlab_registry_enabled | lower }}
    bucket: registry

  appConfig:
    lfs:
      enabled: true
      proxy_download: true
      bucket: git-lfs
      connection:
        secret: gitlab-rails-storage
        key: connection

    artifacts:
      enabled: true
      proxy_download: true
      bucket: gitlab-artifacts
      connection:
        secret: gitlab-rails-storage
        key: connection

    uploads:
      enabled: true
      proxy_download: true
      bucket: gitlab-uploads
      connection:
        secret: gitlab-rails-storage
        key: connection

    packages:
      enabled: true
      proxy_download: true
      bucket: gitlab-packages
      connection:
        secret: gitlab-rails-storage
        key: connection

    backups:
      bucket: gitlab-backups
      tmpBucket: tmp

#=============================================================================
# GITLAB COMPONENTS
#=============================================================================
gitlab:
  webservice:
    enabled: true
    replicas: {{ gitlab_webservice_replicas }}
    resources:
      requests:
        cpu: {{ gitlab_webservice_cpu_request }}
        memory: {{ gitlab_webservice_memory_request }}
      limits:
        cpu: {{ gitlab_webservice_cpu_limit }}
        memory: {{ gitlab_webservice_memory_limit }}
    workerProcesses: {{ gitlab_webservice_workers }}
    puma:
      workerMaxMemory: 1024
    deployment:
      strategy:
        type: RollingUpdate
        rollingUpdate:
          maxSurge: 1
          maxUnavailable: 0

  sidekiq:
    enabled: true
    replicas: {{ gitlab_sidekiq_replicas }}
    resources:
      requests:
        cpu: {{ gitlab_sidekiq_cpu_request }}
        memory: {{ gitlab_sidekiq_memory_request }}
      limits:
        cpu: {{ gitlab_sidekiq_cpu_limit }}
        memory: {{ gitlab_sidekiq_memory_limit }}

  gitlab-shell:
    enabled: true
    replicas: 1
    resources:
      requests:
        cpu: {{ gitlab_shell_cpu_request }}
        memory: {{ gitlab_shell_memory_request }}
      limits:
        cpu: {{ gitlab_shell_cpu_limit }}
        memory: {{ gitlab_shell_memory_limit }}

  gitaly:
    enabled: true
    replicas: 1
    resources:
      requests:
        cpu: {{ gitlab_gitaly_cpu_request }}
        memory: {{ gitlab_gitaly_memory_request }}
      limits:
        cpu: {{ gitlab_gitaly_cpu_limit }}
        memory: {{ gitlab_gitaly_memory_limit }}
    persistence:
      enabled: true
      storageClass: {{ gitlab_storage_class }}
      size: {{ gitlab_gitaly_storage_size }}
      accessMode: ReadWriteOnce

  migrations:
    enabled: true
    resources:
      requests:
        cpu: 250m
        memory: 512Mi
      limits:
        cpu: 1
        memory: 1Gi

#=============================================================================
# CONTAINER REGISTRY
#=============================================================================
registry:
  enabled: {{ gitlab_registry_enabled | lower }}
  replicas: 1
  resources:
    requests:
      cpu: {{ gitlab_registry_cpu_request }}
      memory: {{ gitlab_registry_memory_request }}
    limits:
      cpu: {{ gitlab_registry_cpu_limit }}
      memory: {{ gitlab_registry_memory_limit }}
  storage:
    secret: gitlab-registry-storage
    key: config

#=============================================================================
# POSTGRESQL
#=============================================================================
postgresql:
  install: true
  image:
    tag: 13.6.0
  resources:
    requests:
      cpu: {{ gitlab_postgresql_cpu_request }}
      memory: {{ gitlab_postgresql_memory_request }}
    limits:
      cpu: {{ gitlab_postgresql_cpu_limit }}
      memory: {{ gitlab_postgresql_memory_limit }}
  persistence:
    enabled: true
    storageClass: {{ gitlab_storage_class }}
    size: {{ gitlab_postgresql_storage_size }}
    accessMode: ReadWriteOnce
  metrics:
    enabled: true
    resources:
      requests:
        cpu: 50m
        memory: 64Mi
      limits:
        cpu: 100m
        memory: 128Mi

#=============================================================================
# REDIS
#=============================================================================
redis:
  install: true
  architecture: standalone
  master:
    resources:
      requests:
        cpu: {{ gitlab_redis_cpu_request }}
        memory: {{ gitlab_redis_memory_request }}
      limits:
        cpu: {{ gitlab_redis_cpu_limit }}
        memory: {{ gitlab_redis_memory_limit }}
    persistence:
      enabled: true
      storageClass: {{ gitlab_storage_class }}
      size: {{ gitlab_redis_storage_size }}
      accessMode: ReadWriteOnce
  metrics:
    enabled: true
    resources:
      requests:
        cpu: 50m
        memory: 64Mi
      limits:
        cpu: 100m
        memory: 128Mi

#=============================================================================
# MINIO
#=============================================================================
minio:
  install: {{ gitlab_minio_enabled | lower }}
  replicas: 1
  resources:
    requests:
      cpu: {{ gitlab_minio_cpu_request }}
      memory: {{ gitlab_minio_memory_request }}
    limits:
      cpu: {{ gitlab_minio_cpu_limit }}
      memory: {{ gitlab_minio_memory_limit }}
  persistence:
    enabled: true
    storageClass: {{ gitlab_storage_class }}
    size: {{ gitlab_minio_storage_size }}
    accessMode: ReadWriteOnce
  defaultBuckets:
    - name: registry
    - name: git-lfs
    - name: gitlab-artifacts
    - name: gitlab-uploads
    - name: gitlab-packages
    - name: gitlab-backups
    - name: tmp

#=============================================================================
# DISABLED COMPONENTS
#=============================================================================
nginx-ingress:
  enabled: {{ gitlab_nginx_ingress_enabled | lower }}

certmanager:
  install: {{ gitlab_certmanager_enabled | lower }}
  rbac:
    create: {{ gitlab_certmanager_enabled | lower }}

prometheus:
  install: {{ gitlab_prometheus_enabled | lower }}

gitlab-runner:
  install: false

#=============================================================================
# SHARED SETTINGS
#=============================================================================
shared-secrets:
  enabled: true
  rbac:
    create: true
