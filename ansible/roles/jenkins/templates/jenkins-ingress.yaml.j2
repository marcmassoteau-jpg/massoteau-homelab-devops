---
# Jenkins Traefik IngressRoute
# Generated by Ansible - do not edit manually
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: jenkins-server
  namespace: {{ jenkins_namespace }}
  labels:
    app.kubernetes.io/name: jenkins
    app.kubernetes.io/component: controller
    app.kubernetes.io/part-of: jenkins
    managed-by: ansible
  annotations:
    description: "Jenkins CI/CD web UI ingress via Traefik"
spec:
  entryPoints:
    - web
{% if jenkins_tls_enabled %}
    - websecure
{% endif %}
  routes:
    - match: Host(`{{ jenkins_domain }}`)
      kind: Rule
      services:
        - name: {{ jenkins_release_name }}
          port: 8080
{% if jenkins_tls_enabled %}
  tls:
    certResolver: default
{% endif %}
